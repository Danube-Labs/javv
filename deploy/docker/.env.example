# Copy this file to .env next to compose.yaml, then set the values.
JAVV_BACKEND_URL=https://javv.example.com
JAVV_CLUSTER_ID=docker-host-01
# the two tokens of the cluster in JAVV: Settings > Access & tokens
JAVV_TRIVY_TOKEN=
JAVV_GRYPE_TOKEN=
# the group ID of the Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=
