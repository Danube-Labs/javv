# JAVV self-built Trivy scanner image — per-scanner, never the Trivy Operator.
# The pinned trivy binary is copied from the official pinned image (supply-chain control);
# our package provides the entrypoint. Build context = the REPO ROOT (the package depends
# on the shared libs/javv-common, #156).
#   docker build -f scanner/Dockerfile.trivy -t javv-scanner-trivy .
ARG TRIVY_VERSION=0.76.2

FROM aquasec/trivy:${TRIVY_VERSION} AS trivy

# tag + digest: the digest makes the build reproducible; Renovate updates both
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
# the digest pins the start; the upgrade adds the OS security fixes released after it (issue 1172)
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
# the binary's license (and NOTICE) travel with it: Apache-2.0 4(a) and 4(d); see NOTICE
COPY NOTICE /licenses/NOTICE
COPY scanner/licenses/trivy /licenses/trivy

WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
# uv's own image, tag = versions.yaml toolchain.uv (check-versions.sh), pinned by digest
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /usr/local/bin/uv
# /app is the project; the shared lib lands at /libs so the lock's ../libs/javv-common resolves
COPY libs /libs
COPY scanner/pyproject.toml scanner/uv.lock ./
COPY scanner/src ./src
RUN uv sync --frozen --no-dev

# A fixed non-root user (issue 632). The process writes only the vuln-DB cache (the M10 PVC mount
# point), the dead-letter file and /tmp, so the root filesystem can run read-only. The venv's
# python is the entrypoint: `uv run` creates a cache directory at start even with --no-sync.
RUN groupadd --system --gid 65532 javv \
 && useradd --system --uid 65532 --gid 65532 --no-create-home --home-dir /nonexistent javv \
 && install -d -o 65532 -g 65532 /var/cache/javv/trivy /var/lib/javv
ENV JAVV_SCANNER=trivy \
    TRIVY_CACHE_DIR=/var/cache/javv/trivy \
    JAVV_DEAD_LETTER=/var/lib/javv/trivy.dead-letter.jsonl \
    PATH=/app/.venv/bin:$PATH
USER 65532:65532
ENTRYPOINT ["python", "-m", "scanner"]
